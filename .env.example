# Copy this file to .env and fill in your free API keys.

# Ears (speech-to-text) - https://console.deepgram.com  (free sign-up credit)
DEEPGRAM_API_KEY=

# Brain (LLM). Free tiers are small, so set both keys:
#   groq     - https://console.groq.com/keys  (8,000 tokens/minute)
#   cerebras - https://cloud.cerebras.ai      (5 requests/minute)
# With LLM_PROVIDER=groq, Groq answers and Cerebras takes over whenever Groq hits its limit.
# LLM_PROVIDER=cerebras uses Cerebras alone.
LLM_PROVIDER=groq
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Mouth (text-to-speech) - https://play.cartesia.ai  (free tier)
CARTESIA_API_KEY=
# Pick a voice in the Cartesia playground (Voices tab), click it, and copy its ID.
CARTESIA_VOICE_ID=

# Google Calendar (optional). Without these, bookings are saved only in data/clinic.db.
# GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Google Sheet for call results (optional). Without it, results go to the CRM page and data/calls.csv.
# GOOGLE_SHEET_ID=the-long-id-from-the-sheet-url

# Twilio - https://console.twilio.com (free trial credit). Used for phone calls and
# WhatsApp confirmations. Without these, phone calls are off and messages are only logged.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX        # your Twilio number, for outbound calls
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# STAFF_PHONE_NUMBER=+91XXXXXXXXXX        # optional: live transfers go here during clinic hours

# Deployment: password for the CRM and dashboard when opened from another computer.
# ADMIN_PASSWORD=
# Hugging Face access token (Write) for deploy_hf.py.
# HF_TOKEN=

# Optional tuning
# STT_LANGUAGE=multi          # "multi" = English + Hindi + Hinglish
# TTS_LANGUAGE=en             # try "hi" for a Hindi accent
# LLM_MODEL=                  # override the provider's default model
